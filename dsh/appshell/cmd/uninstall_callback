#!/bin/bash

# 卸载后脚本：按卸载向导的选择决定是否清理用户数据。
#
# 飞牛卸载应用时默认保留应用数据（framework.md），只有应用自己显式清理才会删除，
# 所以这里必须自己做，否则勾了"删除数据"也不会有任何效果。
#
# 向导字段 wizard_data_action 由 fnOS 以同名环境变量注入（生态通用约定：
# 字段名即变量名，参考 1panel 的 wizard_delete_data）：
#   keep（默认）—— 保留全部数据
#   sessions    —— 只删除会话与凭据（.dsh），保留工作区文档
#   delete      —— 删除全部应用数据（整个共享数据目录：.dsh、Documents 等）
# 同时兼容其他应用常用的 checkbox 约定：wizard_delete_data=true 等价于 delete。

set -u

APPNAME="${TRIM_APPNAME:-dsh}"
DATA_ACTION="${wizard_data_action:-${data_action:-keep}}"
DELETE_FLAG="${wizard_delete_data:-false}"
VAR_DIR="${TRIM_PKGVAR:-}"
SHARE_DIR="${TRIM_DATA_SHARE_PATHS:-}"
SHARE_DIR="${SHARE_DIR%%:*}"

LOG="${VAR_DIR:-/tmp}/uninstall.log"
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null || true; }

log "uninstall_callback: data_action=${DATA_ACTION} delete_data=${DELETE_FLAG} share=${SHARE_DIR:-<未设置>} var=${VAR_DIR:-<未设置>}"

# checkbox 约定：勾选即等价于彻底删除（显式选 sessions 时以其为准）
if [ "${DELETE_FLAG}" = "true" ] && [ "${DATA_ACTION}" != "sessions" ]; then
    DATA_ACTION="delete"
fi

case "${DATA_ACTION}" in
    sessions|delete) ;;
    *)
        log "用户选择保留数据（${DATA_ACTION}），不做任何清理"
        exit 0
        ;;
esac

# 只删除应用自己管理的数据，并且路径必须落在飞牛的应用目录内（防误删）。
# 允许目标就是应用数据根目录本身（delete 模式整目录删除），但不允许更上层目录。
delete_dir() {
    local p="$1"
    [ -n "${p}" ] || return 0
    case "${p}" in
        /vol*/@appshare/"${APPNAME}"|/vol*/@appshare/"${APPNAME}"/*|/vol*/@appdata/"${APPNAME}"|/vol*/@appdata/"${APPNAME}"/*) ;;
        *)
            log "拒绝清理非法路径：${p}"
            return 0
            ;;
    esac
    if [ -e "${p}" ]; then
        if rm -rf -- "${p}" 2>/dev/null; then
            log "已删除：${p}"
        else
            log "删除失败：${p}"
        fi
    else
        log "无需删除（不存在）：${p}"
    fi
}

# 候选根目录：共享目录（用户数据主位置）+ 各卷 appshare/appdata
# （DSH 在共享目录不可用时会回退到 var 目录存放 .dsh）
ROOTS=""
[ -n "${SHARE_DIR}" ] && ROOTS="${SHARE_DIR} "
[ -n "${VAR_DIR}" ] && ROOTS="${ROOTS}${VAR_DIR} "
for base in /vol*/@appshare/"${APPNAME}" /vol*/@appdata/"${APPNAME}"; do
    [ -d "${base}" ] && ROOTS="${ROOTS}${base} "
done

for base in ${ROOTS}; do
    base="${base%/}"
    if [ "${DATA_ACTION}" = "delete" ]; then
        # 彻底删除：整个应用数据目录（.dsh、Documents、config-export 等一并清掉）
        delete_dir "${base}"
    else
        # 仅删除会话与凭据，保留工作区文档
        delete_dir "${base}/.dsh"
    fi
done

# delete 模式：再把 var 目录里的残留（日志、pid 等）清空，与"删除全部数据"保持一致
if [ "${DATA_ACTION}" = "delete" ] && [ -n "${VAR_DIR}" ] && [ "${VAR_DIR}" != "/" ]; then
    case "${VAR_DIR}" in
        /vol*/@appdata/"${APPNAME}"|/vol*/@appdata/"${APPNAME}"/*)
            find "${VAR_DIR}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null || true
            log "已清空 var 目录内容：${VAR_DIR}"
            ;;
        *)
            log "跳过 var 目录清理（路径不合法）：${VAR_DIR}"
            ;;
    esac
fi

log "卸载清理完成（模式：${DATA_ACTION}）"
exit 0
