#!/bin/sh
# fnOS 无桌面环境：dsh「设置 → 打开配置文件」调用 xdg-open 必然失败。
# 本垫片把目标文件导出到共享数据目录（文件管理 / SMB 可见）后正常退出，
# 按钮不再报错，用户也能直接拿到配置文件。
# 由 cmd/main 把应用 bin 目录前置到 PATH 使其优先生效。
target="$1"
[ -n "$target" ] || exit 0
case "$target" in
    http://*|https://*|mailto:*|ftp:*|ftp://*) exit 0 ;;
esac
[ -f "$target" ] || exit 0
dest="${DSH_EXPORT_DIR:-${DSH_DATA_DIR:-/tmp}/config-export}"
mkdir -p "$dest" 2>/dev/null || exit 0
cp -f "$target" "$dest/$(basename "$target")" 2>/dev/null || exit 0
exit 0
