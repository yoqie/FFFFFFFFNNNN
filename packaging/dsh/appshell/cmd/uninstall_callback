#!/bin/bash
# 卸载后：按卸载向导的选择清理应用数据。
#
# 飞牛卸载应用时默认保留数据，只有应用自己显式清理才会删除，所以这里自己做。
# 向导字段 wizard_data_action 由 fnOS 以同名环境变量注入（生态约定：字段名即变量名）。
#   keep（默认）—— 保留全部数据
#   sessions     —— 只删会话与凭据（.dsh），保留工作区文档
#   delete       —— 删除全部应用数据（.dsh、Documents 等）
set -u

APPNAME="${TRIM_APPNAME:-dsh}"
ACTION="${wizard_data_action:-keep}"
VAR_DIR="${TRIM_PKGVAR:-}"
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

LOG="${VAR_DIR:-/tmp}/uninstall.log"
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null || true; }

log "uninstall_callback: data_action=${ACTION} share=${SHARE_DIR:-<未设置>} var=${VAR_DIR:-<未设置>}"

case "${ACTION}" in
    sessions|delete) ;;
    *)
        log "用户选择保留数据（${ACTION}），不做清理"
        exit 0
        ;;
esac

# 只删应用自己的目录：路径必须落在飞牛的应用目录内，防止误删
safe_delete() {
    local target="$1"
    [ -n "${target}" ] || return 0
    case "${target}" in
        /vol*/@appshare/"${APPNAME}"|/vol*/@appshare/"${APPNAME}"/*|\
        /vol*/@appdata/"${APPNAME}"|/vol*/@appdata/"${APPNAME}"/*) ;;
        *)
            log "拒绝清理非法路径：${target}"
            return 0
            ;;
    esac
    if [ -e "${target}" ]; then
        rm -rf -- "${target}" 2>/dev/null && log "已删除：${target}" || log "删除失败：${target}"
    fi
}

ROOTS=""
[ -n "${SHARE_DIR}" ] && ROOTS="${SHARE_DIR} "
[ -n "${VAR_DIR}" ] && ROOTS="${ROOTS}${VAR_DIR} "
for base in /vol*/@appshare/"${APPNAME}" /vol*/@appdata/"${APPNAME}"; do
    [ -d "${base}" ] && ROOTS="${ROOTS}${base} "
done

for base in ${ROOTS}; do
    base="${base%/}"
    if [ "${ACTION}" = "delete" ]; then
        safe_delete "${base}"
    else
        # 只删会话与凭据，工作区文档（可能存着代码仓库）保留
        safe_delete "${base}/.dsh"
    fi
done

log "卸载清理完成（模式：${ACTION}）"
exit 0
