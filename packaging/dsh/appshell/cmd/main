#!/bin/bash

# =============================================================
# DSH —— 飞牛 fnOS 生命周期脚本
#
# 架构（无代理、无 cookie 伪造，全部用 dsh 自己的官方能力）：
#
#   浏览器 ──► 3080 gate（入口跳转器） ──302+令牌──► 3081 dsh web
#                                                     │
#                            Set-Cookie: dsh-auth-… ◄─┘（dsh 自己签发）
#
#   * dsh web 直接绑定 NAS 的局域网 IP（官方 --host，不接受 0.0.0.0）
#   * 浏览器认证走 dsh 自己的「启动令牌 → 持久 cookie」流程
#   * gate 只做一次 302，跳转后所有流量直连 dsh（含 WebSocket）
#
# 环境：Node 由应用中心 nodejs_v24 提供（manifest 的 install_dep_apps）
# =============================================================

set -u

APPNAME="${TRIM_APPNAME:-dsh}"
APPDEST="${TRIM_APPDEST:-}"
PKGVAR="${TRIM_PKGVAR:-}"

if [ -z "${APPDEST}" ] || [ -z "${PKGVAR}" ]; then
    echo "ERROR: TRIM_APPDEST / TRIM_PKGVAR 未设置" >&2
    exit 1
fi

# 对外端口（飞牛桌面入口 / manifest 的 service_port）；dsh 本体用下一个端口
SERVICE_PORT="${TRIM_SERVICE_PORT:-3080}"
DSH_PORT=$((SERVICE_PORT + 1))

NODE_RUNTIME="/var/apps/nodejs_v24/target/bin/node"
DSH_BIN="${APPDEST}/node_modules/@deepseek-ai/dsh/lib/bin.js"
GATE_JS="${APPDEST}/gate/gate.js"
PATCH_FILE="${APPDEST}/gate/fnos.yml"
PNPM_BIN="${APPDEST}/node_modules/.bin/pnpm"

# 数据目录：优先共享目录（文件管理 / SMB 可见），回退 var 目录
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "${DATA_DIR}" ] || [ ! -d "${DATA_DIR}" ]; then
    DATA_DIR="${PKGVAR}"
fi
mkdir -p "${DATA_DIR}" 2>/dev/null || true

LOG_FILE="${PKGVAR}/${APPNAME}.log"
PID_FILE="${PKGVAR}/${APPNAME}.pid"
GATE_PID_FILE="${PKGVAR}/${APPNAME}-gate.pid"
WATCHDOG_PID_FILE="${PKGVAR}/${APPNAME}-watchdog.pid"
TOKEN_FILE="${PKGVAR}/launch-token"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }
tell() { echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true; }

# 日志超过 10MB 轮转一份，避免无限增长
if [ -f "${LOG_FILE}" ] && [ "$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)" -gt 10485760 ]; then
    mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
fi

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

read_pid() {
    local file="$1" pid
    [ -f "${file}" ] || return 1
    pid=$(head -n 1 "${file}" 2>/dev/null | tr -d '[:space:]')
    alive "${pid}" || return 1
    printf '%s' "${pid}"
}

# 按命令行特征找回实例（PID 文件丢失时的兜底）
find_dsh_pid() { pgrep -f "${DSH_BIN} web --patch" 2>/dev/null | head -n 1; }
find_gate_pid() { pgrep -f "${GATE_JS}" 2>/dev/null | grep -vx "$$" | head -n 1; }

# ---------- 局域网地址 ----------
# dsh 的 --host 必须是一个具体的本机地址（通配地址会被拒绝），
# 取默认路由的源地址最接近"用户实际访问的那个 IP"。
detect_lan_ip() {
    local ip=""
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)
    [ -n "${ip}" ] || ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9.]+$' | grep -v '^127\.' | head -n 1)
    [ -n "${ip}" ] || ip="127.0.0.1"
    printf '%s' "${ip}"
}

# ---------- 运行时环境 ----------
setup_env() {
    LAN_IP="${DSH_LAN_IP:-$(detect_lan_ip)}"

    export HOME="${DATA_DIR}"
    # dsh 的 home 解析顺序是 显式配置 > $DSH_HOME > os.homedir()/.dsh；
    # os.homedir() 读 passwd 家目录（不认 $HOME），不设会把配置与凭据写到
    # /home/<app>/.dsh，导致每次重装都丢配置。DSH_HOME 指向 .dsh 本身。
    export DSH_HOME="${DATA_DIR}/.dsh"
    mkdir -p "${DSH_HOME}" 2>/dev/null || true

    # 默认工作区定位用 xdg-user-dir DOCUMENTS；fnOS 未配置该 XDG 变量时它会
    # 回退到 $HOME，而 dsh 认为"文档目录 == HOME"不可用，会报无法创建工作区。
    mkdir -p "${DATA_DIR}/Documents" 2>/dev/null || true
    export XDG_DOCUMENTS_DIR="${DATA_DIR}/Documents"

    # 应用用户的登录 shell 是 nologin；不指定会让内置终端一开就退出
    export SHELL="/bin/bash"

    export PATH="$(dirname "${NODE_RUNTIME}"):/usr/local/bin:/usr/bin:/bin"
}

# ---------- 补丁层 ----------
# 用 --patch 叠加一个只读补丁（不碰用户的 cordis.patch.yml）：
#   plugin-manager 的 pnpmCommand 指向随包的 pnpm，插件市场/插件安装才可用。
# dsh 的插件安装器直接 execa("pnpm")，服务端 PATH 里没有 pnpm 就会失败；
# 官方提供了 pnpmCommand 配置项，比改 PATH 干净。
write_patch() {
    mkdir -p "$(dirname "${PATCH_FILE}")" 2>/dev/null || true
    if [ -x "${PNPM_BIN}" ]; then
        cat > "${PATCH_FILE}" <<YAML
# 由 fnOS 应用启动脚本生成，请勿手工修改（每次启动会重写）
- id: plugin-manager
  name: '@deepseek-ai/dsh-plugin-manager'
  config:
    pnpmCommand: '${PNPM_BIN}'
YAML
    else
        # 没带上 pnpm 时保持上游默认（插件安装不可用，核心功能不受影响）
        cat > "${PATCH_FILE}" <<'YAML'
# 由 fnOS 应用启动脚本生成，请勿手工修改（每次启动会重写）
[]
YAML
    fi
}

# ---------- 启动 ----------
wait_token() {
    # dsh 打印的地址里带一次性启动令牌；取到后写进文件供 gate 使用。
    #
    # 日志是追加写的（跨重启保留），所以只能扫描「本次启动之后新增」的部分：
    # 直接 grep 整个文件时，上一次运行留下的旧令牌会让第一轮循环立刻命中，
    # 把过期令牌写进 TOKEN_FILE；浏览器经 gate 跳到 3081 后拿到 401，表现就是
    # 「打不开网页」。先记下启动前的字节偏移，之后只 tail 新增内容。
    local i token offset
    offset="${LOG_OFFSET:-0}"
    for i in $(seq 1 120); do
        token=$(tail -c "+$((offset + 1))" "${LOG_FILE}" 2>/dev/null \
            | grep -o 'token=[A-Za-z0-9_-]\{16,\}' | tail -n 1 | cut -d= -f2)
        if [ -n "${token}" ]; then
            printf '%s' "${token}" > "${TOKEN_FILE}"
            log "已取得启动令牌（长度 ${#token}）"
            return 0
        fi
        sleep 1
    done
    log "ERROR: 60 秒内未取得启动令牌"
    return 1
}

# ---------- 子进程 ----------
# 起 dsh 本体并等到启动令牌；成功后 PID 写入 PID_FILE，返回 0。
# 单独拆出来是因为看门狗重启时也要走完全一样的一套（含令牌刷新）。
spawn_dsh() {
    local dsh_pid
    rm -f "${TOKEN_FILE}"
    cd "${DATA_DIR}" || return 1

    # 记录本次启动前的日志字节数：wait_token 只扫描之后新增的内容，避免命中
    # 上一次运行留在日志里的旧令牌（见 wait_token 的注释）。
    LOG_OFFSET=$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)

    # 参数说明：
    #   --patch        叠加 pnpmCommand 补丁层（不修改用户配置）
    #   --host/--port  绑定 NAS 局域网 IP（dsh 拒绝通配地址）
    #   --trusted-host 允许从该 authority 访问（Origin 校验用）
    #   --public-url   对外地址，决定 dsh 打印与回跳的 URL
    #   --no-open      无桌面环境，不要尝试拉起浏览器
    "${NODE_RUNTIME}" "${DSH_BIN}" web \
        --patch "${PATCH_FILE}" \
        --host "${LAN_IP}" \
        --port "${DSH_PORT}" \
        --trusted-host "${LAN_IP}:${DSH_PORT}" \
        --public-url "http://${LAN_IP}:${DSH_PORT}/" \
        --no-open >> "${LOG_FILE}" 2>&1 &
    dsh_pid=$!
    printf '%s' "${dsh_pid}" > "${PID_FILE}"

    if ! wait_token; then
        kill -TERM "${dsh_pid}" 2>/dev/null || true
        rm -f "${PID_FILE}"
        return 1
    fi
    return 0
}

# 入口跳转器：只做 302，跳转后流量直连 dsh。已经在跑就不重复起。
start_gate() {
    local pid
    if pid=$(read_pid "${GATE_PID_FILE}"); then
        return 0
    fi
    # dsh 只绑局域网 IP，127.0.0.1 上没人监听；让 gate 额外监听回环，
    # 「在 NAS 本机上开浏览器」才能用 127.0.0.1:3080 进来。
    DSH_GATE_HOST="${LAN_IP}" \
    DSH_GATE_PORT="${SERVICE_PORT}" \
    DSH_GATE_EXTRA_HOSTS="${DSH_GATE_EXTRA_HOSTS:-127.0.0.1}" \
    DSH_WEB_HOST="${LAN_IP}" \
    DSH_WEB_PORT="${DSH_PORT}" \
    DSH_TOKEN_FILE="${TOKEN_FILE}" \
        "${NODE_RUNTIME}" "${GATE_JS}" >> "${LOG_FILE}" 2>&1 &
    printf '%s' "$!" > "${GATE_PID_FILE}"
}

# 看门狗：dsh 意外退出（典型是堆内存耗尽）时自动把它拉起来，并刷新启动令牌。
# 没有它的话，dsh 一崩，gate 还在 3080 上把浏览器 302 到没人监听的 3081，
# 用户看到的就是「无法访问此网站」。
start_watchdog() {
    local pid
    if pid=$(read_pid "${WATCHDOG_PID_FILE}"); then
        return 0
    fi
    (
        local fails=0 delay interval
        interval="${DSH_WATCHDOG_INTERVAL:-10}"
        while :; do
            sleep "${interval}"
            if ! read_pid "${PID_FILE}" >/dev/null; then
                log "看门狗：dsh 已退出，自动重启"
                if spawn_dsh; then
                    fails=0
                    log "看门狗：dsh 已重启（PID $(cat "${PID_FILE}" 2>/dev/null)）"
                else
                    # 连续失败时退避，避免起不来时把日志刷爆
                    fails=$((fails + 1))
                    delay=$((fails * interval))
                    [ "${delay}" -gt 300 ] && delay=300
                    log "看门狗：重启失败（连续 ${fails} 次），${delay} 秒后重试"
                    sleep "${delay}"
                fi
            fi
        done
    ) >> "${LOG_FILE}" 2>&1 &
    printf '%s' "$!" > "${WATCHDOG_PID_FILE}"
}

start_process() {
    local pid dsh_pid i
    if pid=$(read_pid "${PID_FILE}"); then
        log "${APPNAME} 已在运行（PID ${pid}）"
        start_gate
        start_watchdog
        return 0
    fi
    pid=$(find_dsh_pid)
    if alive "${pid}"; then
        printf '%s' "${pid}" > "${PID_FILE}"
        log "已找回运行中的 dsh（PID ${pid}）"
        start_gate
        start_watchdog
        return 0
    fi

    if [ ! -x "${NODE_RUNTIME}" ]; then
        log "ERROR: 未找到 Node 运行时 ${NODE_RUNTIME}"
        tell "✗ 未找到 Node.js 运行时，请先在应用中心安装 nodejs_v24"
        return 1
    fi
    if [ ! -f "${DSH_BIN}" ]; then
        log "ERROR: DSH 本体缺失 ${DSH_BIN}"
        tell "✗ DSH 本体缺失，安装包不完整，请重新安装"
        return 1
    fi

    setup_env
    write_patch

    log "启动 dsh web（${LAN_IP}:${DSH_PORT}，入口 ${SERVICE_PORT}）"
    if ! spawn_dsh; then
        tell "✗ DSH 启动失败，请查看日志 ${LOG_FILE}"
        return 1
    fi
    dsh_pid=$(read_pid "${PID_FILE}")
    start_gate

    # 10 秒探测：进程秒退要如实报错，不能误报启动成功
    for i in $(seq 1 10); do
        if ! alive "${dsh_pid}"; then
            log "ERROR: dsh 进程在 ${i} 秒内退出"
            tell "✗ DSH 启动失败，请查看日志 ${LOG_FILE}"
            rm -f "${PID_FILE}" "${GATE_PID_FILE}" "${TOKEN_FILE}"
            return 1
        fi
        sleep 1
    done
    start_watchdog
    log "已启动（dsh PID ${dsh_pid}，入口端口 ${SERVICE_PORT}）"
    return 0
}

# ---------- 停止 ----------
stop_process() {
    log "正在停止 ${APPNAME}"
    local pid

    # 先停看门狗：否则它会把下面刚停掉的 dsh 又拉起来
    if pid=$(read_pid "${WATCHDOG_PID_FILE}"); then
        kill -TERM "${pid}" 2>/dev/null || true
        sleep 1
        alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${WATCHDOG_PID_FILE}" 2>/dev/null || true

    # 再停入口，避免跳转到正在关闭的服务
    if pid=$(read_pid "${GATE_PID_FILE}"); then
        kill -TERM "${pid}" 2>/dev/null || true
    fi
    for pid in $(find_gate_pid); do kill -TERM "${pid}" 2>/dev/null || true; done

    if pid=$(read_pid "${PID_FILE}"); then
        kill -TERM "${pid}" 2>/dev/null || true
        local i
        for i in $(seq 1 10); do
            alive "${pid}" || break
            sleep 1
        done
        alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    fi

    # 兜底：清理路径限定在本应用的残留进程，避免误杀
    for pid in $(pgrep -f "${DSH_BIN}" 2>/dev/null; pgrep -f "${GATE_JS}" 2>/dev/null); do
        [ -n "${pid}" ] && [ "${pid}" != "$$" ] && kill -KILL "${pid}" 2>/dev/null || true
    done

    rm -f "${PID_FILE}" "${GATE_PID_FILE}" "${WATCHDOG_PID_FILE}" "${TOKEN_FILE}" 2>/dev/null || true
    sleep 1
    if ss -tln 2>/dev/null | grep -qE ":(${SERVICE_PORT}|${DSH_PORT}) "; then
        log "ERROR: 停止后端口仍被占用"
        return 1
    fi
    log "已停止"
    return 0
}

status_process() {
    local pid
    if pid=$(read_pid "${PID_FILE}"); then return 0; fi
    pid=$(find_dsh_pid)
    if alive "${pid}"; then
        printf '%s' "${pid}" > "${PID_FILE}"
        return 0
    fi
    return 3
}

case "${1:-}" in
    start)
        if start_process; then echo "✓ 启动成功"; exit 0; else echo "✗ 启动失败（日志 ${LOG_FILE}）"; exit 1; fi
        ;;
    stop)
        if stop_process; then echo "✓ 已停止"; exit 0; else echo "✗ 停止失败：端口仍被占用"; exit 1; fi
        ;;
    uninstall)
        stop_process >/dev/null 2>&1
        echo "✓ 已清理"
        exit 0
        ;;
    status)
        if status_process; then echo "✓ 服务运行中"; exit 0; else echo "✗ 服务未运行"; exit 3; fi
        ;;
    restart)
        stop_process >/dev/null 2>&1
        if start_process; then echo "✓ 重启成功"; exit 0; else echo "✗ 重启失败"; exit 1; fi
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart|uninstall}"
        exit 1
        ;;
esac
