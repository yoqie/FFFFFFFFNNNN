#!/bin/bash

# =============================================================
# DSH —— 飞牛 fnOS 生命周期脚本
#
# 架构（单入口反向代理，浏览器只看到一个源）：
#
#   浏览器 ──► 3080 runner（HTTP + WebSocket 代理，本应用唯一对外端口）
#                 │
#                 └──► 127.0.0.1:3081 dsh web（仅回环，外部不可直连）
#
#   * dsh 只监听回环，Runner 在 0.0.0.0 上代理，浏览器地址栏始终是
#     http://NAS:3080，所有请求同源 —— dsh 的 /api browser-trust 围栏
#     （Origin 必须与 Host 同源）因此不会误伤插件安装/卸载。
#   * 认证由 Runner 用 .credentials.yaml 里的 browser-session secret
#     自签 dsh 会话 cookie，浏览器无需处理启动令牌，也收不到 Set-Cookie。
#   * Runner 负责拉起 dsh 并在其异常退出时重启；本脚本的看门狗只在
#     Runner 整个进程意外死亡时兜底。
#
# 环境：Node 由应用中心 nodejs_v24 提供（manifest 的 install_dep_apps）
# =============================================================

set -u

APPNAME="${TRIM_APPNAME:-dsh}"
APPDEST="${TRIM_APPDEST:-}"
PKGVAR="${TRIM_PKGVAR:-}"

if [ -z "${APPDEST}" ] || [ -z "${PKGVAR}" ]; then
    echo "ERROR: TRIM_APPDEST / TRIM_PKGVAR 未设置" >&2
    exit 1
fi

# 对外端口（飞牛桌面入口 / manifest 的 service_port）；dsh 本体用下一个端口
SERVICE_PORT="${TRIM_SERVICE_PORT:-3080}"
DSH_PORT=$((SERVICE_PORT + 1))

NODE_RUNTIME="/var/apps/nodejs_v24/target/bin/node"
DSH_BIN="${APPDEST}/node_modules/@deepseek-ai/dsh/lib/bin.js"
RUNNER_JS="${APPDEST}/runner/runner.js"
PNPM_BIN="${APPDEST}/node_modules/.bin/pnpm"
PATCH_FILE="${PKGVAR}/patch.yml"

# 数据目录：优先共享目录（文件管理 / SMB 可见），回退 var 目录
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "${DATA_DIR}" ] || [ ! -d "${DATA_DIR}" ]; then
    DATA_DIR="${PKGVAR}"
fi
mkdir -p "${DATA_DIR}" 2>/dev/null || true

LOG_FILE="${PKGVAR}/${APPNAME}.log"
PID_FILE="${PKGVAR}/${APPNAME}.pid"
WATCHDOG_PID_FILE="${PKGVAR}/${APPNAME}-watchdog.pid"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }
tell() { echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true; }

# 日志超过 10MB 轮转一份，避免无限增长
if [ -f "${LOG_FILE}" ] && [ "$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)" -gt 10485760 ]; then
    mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
fi

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

read_pid() {
    local file="$1" pid
    [ -f "${file}" ] || return 1
    pid=$(head -n 1 "${file}" 2>/dev/null | tr -d '[:space:]')
    alive "${pid}" || return 1
    printf '%s' "${pid}"
}

# 按命令行特征找回实例（PID 文件丢失时的兜底）
find_runner_pid() { pgrep -f "${RUNNER_JS}" 2>/dev/null | grep -vx "$$" | head -n 1; }

# ---------- 局域网地址 ----------
# dsh 的 --public-url 决定它打印/上报的访问地址，取默认路由的源地址最接近
# 「用户实际访问的那个 IP」。
detect_lan_ip() {
    local ip=""
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)
    [ -n "${ip}" ] || ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9.]+$' | grep -v '^127\.' | head -n 1)
    [ -n "${ip}" ] || ip="127.0.0.1"
    printf '%s' "${ip}"
}

# ---------- 运行时环境 ----------
setup_env() {
    LAN_IP="${DSH_LAN_IP:-$(detect_lan_ip)}"

    export HOME="${DATA_DIR}"
    # dsh 的 home 解析顺序是 显式配置 > $DSH_HOME > os.homedir()/.dsh；
    # os.homedir() 读 passwd 家目录（不认 $HOME），不设会把配置与凭据写到
    # /home/<app>/.dsh，导致每次重装都丢配置。DSH_HOME 指向 .dsh 本身。
    export DSH_HOME="${DATA_DIR}/.dsh"
    mkdir -p "${DSH_HOME}" 2>/dev/null || true

    # 默认工作区定位用 xdg-user-dir DOCUMENTS；fnOS 未配置该 XDG 变量时它会
    # 回退到 $HOME，而 dsh 认为"文档目录 == HOME"不可用，会报无法创建工作区。
    mkdir -p "${DATA_DIR}/Documents" 2>/dev/null || true
    export XDG_DOCUMENTS_DIR="${DATA_DIR}/Documents"

    # 应用用户的登录 shell 是 nologin；不指定会让内置终端一开就退出
    export SHELL="/bin/bash"

    export PATH="$(dirname "${NODE_RUNTIME}"):/usr/local/bin:/usr/bin:/bin"
}

# ---------- 补丁层 ----------
# 用 --patch 叠加一个只读补丁（不碰用户的 cordis.patch.yml）：
#   plugin-manager 的 pnpmCommand 指向随包的 pnpm，插件市场/插件安装才可用。
# dsh 的插件安装器直接 execa("pnpm")，服务端 PATH 里没有 pnpm 就会失败；
# 官方提供了 pnpmCommand 配置项，比改 PATH 干净。
write_patch() {
    mkdir -p "$(dirname "${PATCH_FILE}")" 2>/dev/null || true
    if [ -x "${PNPM_BIN}" ]; then
        cat > "${PATCH_FILE}" <<YAML
# 由 fnOS 应用启动脚本生成，请勿手工修改（每次启动会重写）
- id: plugin-manager
  name: '@deepseek-ai/dsh-plugin-manager'
  config:
    pnpmCommand: '${PNPM_BIN}'
YAML
    else
        # 没带上 pnpm 时保持上游默认（插件安装不可用，核心功能不受影响）
        cat > "${PATCH_FILE}" <<'YAML'
# 由 fnOS 应用启动脚本生成，请勿手工修改（每次启动会重写）
[]
YAML
    fi
}

# ---------- 探活 ----------
# Runner 在 dsh 就绪前对页面请求返回 502，就绪后 200（认证由它自己签）。
probe_ready() {
    "${NODE_RUNTIME}" -e '
        const http = require("http");
        const [port, dshPort] = process.argv.slice(1);
        const req = http.request({
            host: "127.0.0.1", port: Number(port), path: "/", method: "GET",
            headers: { host: `127.0.0.1:${dshPort}` },
        }, (res) => { res.resume(); process.exit(res.statusCode === 200 ? 0 : 1); });
        req.setTimeout(3000, () => { req.destroy(); process.exit(1); });
        req.on("error", () => process.exit(1));
        req.end();
    ' "${SERVICE_PORT}" "${DSH_PORT}" 2>/dev/null
}

wait_ready() {
    local i
    for i in $(seq 1 120); do
        probe_ready && return 0
        alive "$(read_pid "${PID_FILE}")" || return 1
        sleep 1
    done
    return 1
}

# ---------- 子进程 ----------
spawn_runner() {
    local pid
    DSH_NODE_BIN="${NODE_RUNTIME}" \
    DSH_PORT="${DSH_PORT}" \
    DSH_PATCH_FILE="${PATCH_FILE}" \
    DSH_PUBLIC_URL="http://${LAN_IP}:${SERVICE_PORT}/" \
        "${NODE_RUNTIME}" "${RUNNER_JS}" >> "${LOG_FILE}" 2>&1 &
    pid=$!
    printf '%s' "${pid}" > "${PID_FILE}"
    printf '%s' "${pid}"
}

# 看门狗：Runner 整个进程意外退出时兜底重启。
# dsh 本体由 Runner 自己看护，这里不管；只有 Runner 没了才需要拉起来。
start_watchdog() {
    local pid
    if pid=$(read_pid "${WATCHDOG_PID_FILE}"); then
        return 0
    fi
    (
        local fails=0 delay interval
        interval="${DSH_WATCHDOG_INTERVAL:-10}"
        while :; do
            sleep "${interval}"
            if ! read_pid "${PID_FILE}" >/dev/null; then
                log "看门狗：runner 已退出，自动重启"
                if spawn_runner >/dev/null && wait_ready; then
                    fails=0
                    log "看门狗：runner 已重启（PID $(cat "${PID_FILE}" 2>/dev/null)）"
                else
                    # 连续失败时退避，避免起不来时把日志刷爆
                    fails=$((fails + 1))
                    delay=$((fails * interval))
                    [ "${delay}" -gt 300 ] && delay=300
                    log "看门狗：重启失败（连续 ${fails} 次），${delay} 秒后重试"
                    sleep "${delay}"
                fi
            fi
        done
    ) >> "${LOG_FILE}" 2>&1 &
    printf '%s' "$!" > "${WATCHDOG_PID_FILE}"
}

start_process() {
    local pid
    setup_env
    write_patch

    if pid=$(read_pid "${PID_FILE}"); then
        log "${APPNAME} 已在运行（PID ${pid}）"
        start_watchdog
        return 0
    fi
    pid=$(find_runner_pid)
    if alive "${pid}"; then
        printf '%s' "${pid}" > "${PID_FILE}"
        log "已找回运行中的 runner（PID ${pid}）"
        start_watchdog
        return 0
    fi

    if [ ! -x "${NODE_RUNTIME}" ]; then
        log "ERROR: 未找到 Node 运行时 ${NODE_RUNTIME}"
        tell "✗ 未找到 Node.js 运行时，请先在应用中心安装 nodejs_v24"
        return 1
    fi
    if [ ! -f "${RUNNER_JS}" ]; then
        log "ERROR: runner 缺失 ${RUNNER_JS}"
        tell "✗ 启动器缺失，安装包不完整，请重新安装"
        return 1
    fi
    if [ ! -f "${DSH_BIN}" ]; then
        log "ERROR: DSH 本体缺失 ${DSH_BIN}"
        tell "✗ DSH 本体缺失，安装包不完整，请重新安装"
        return 1
    fi

    log "启动 runner（入口 ${LAN_IP}:${SERVICE_PORT} → 127.0.0.1:${DSH_PORT}）"
    spawn_runner >/dev/null

    if ! wait_ready; then
        log "ERROR: 120 秒内未就绪，请查看日志"
        tell "✗ DSH 启动失败，请查看日志 ${LOG_FILE}"
        stop_process >/dev/null 2>&1
        return 1
    fi
    start_watchdog
    log "已启动（runner PID $(cat "${PID_FILE}" 2>/dev/null)，入口端口 ${SERVICE_PORT}）"
    return 0
}

# ---------- 停止 ----------
stop_process() {
    log "正在停止 ${APPNAME}"
    local pid i

    # 先停看门狗：否则它会把下面刚停掉的 runner 又拉起来
    if pid=$(read_pid "${WATCHDOG_PID_FILE}"); then
        kill -TERM "${pid}" 2>/dev/null || true
        sleep 1
        alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${WATCHDOG_PID_FILE}" 2>/dev/null || true

    if pid=$(read_pid "${PID_FILE}"); then
        kill -TERM "${pid}" 2>/dev/null || true
        for i in $(seq 1 10); do
            alive "${pid}" || break
            sleep 1
        done
        alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    fi

    # 兜底：清理本应用路径下的残留进程（runner 与它拉起的 dsh），避免误杀
    for pid in $(find_runner_pid; pgrep -f "${DSH_BIN} web" 2>/dev/null); do
        [ -n "${pid}" ] && [ "${pid}" != "$$" ] && kill -KILL "${pid}" 2>/dev/null || true
    done

    rm -f "${PID_FILE}" "${WATCHDOG_PID_FILE}" 2>/dev/null || true
    sleep 1
    if ss -tln 2>/dev/null | grep -qE ":(${SERVICE_PORT}|${DSH_PORT}) "; then
        log "ERROR: 停止后端口仍被占用"
        return 1
    fi
    log "已停止"
    return 0
}

status_process() {
    local pid
    if pid=$(read_pid "${PID_FILE}"); then return 0; fi
    pid=$(find_runner_pid)
    if alive "${pid}"; then
        printf '%s' "${pid}" > "${PID_FILE}"
        return 0
    fi
    return 3
}

case "${1:-}" in
    start)
        if start_process; then echo "✓ 启动成功"; exit 0; else echo "✗ 启动失败（日志 ${LOG_FILE}）"; exit 1; fi
        ;;
    stop)
        if stop_process; then echo "✓ 已停止"; exit 0; else echo "✗ 停止失败：端口仍被占用"; exit 1; fi
        ;;
    uninstall)
        stop_process >/dev/null 2>&1
        echo "✓ 已清理"
        exit 0
        ;;
    status)
        if status_process; then echo "✓ 服务运行中"; exit 0; else echo "✗ 服务未运行"; exit 3; fi
        ;;
    restart)
        stop_process >/dev/null 2>&1
        if start_process; then echo "✓ 重启成功"; exit 0; else echo "✗ 重启失败"; exit 1; fi
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart|uninstall}"
        exit 1
        ;;
esac
