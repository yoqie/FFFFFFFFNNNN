#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

SERVICE_COMMAND="$APP_DIR/1panel-core
$APP_DIR/1panel-agent"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

# 1panel's binary reads its port, base directory and other startup params by
# grepping /usr/local/bin/1pctl (see core/utils/common/common.go LoadParams).
# Without those keys it panics on boot with:
#   panic: error `BASE_DIR` find in /usr/local/bin/1pctl
#
# That file lives outside the app's own directories and needs root to write.
# fnOS runs every hook as the app's configured run-as user, so while this app
# ran as the unprivileged "1panel" user the seeding below could never succeed:
# CREDENTIALS.txt came out owned by 1panel:1panel and the next write failed with
# "/usr/local/bin/1pctl: Permission denied" (/usr/local/bin is root:root 755),
# leaving the app permanently panicking on start.
#
# The app is therefore packaged as a root install (`install_type = root` in the
# manifest plus `"run-as": "root"` in config/privilege, same as nvidia-driver /
# surface-battery). Upstream 1panel expects root anyway: it manages Docker,
# system services and the firewall. Note this also places the app under
# /usr/local/apps rather than on a storage volume.
#
# seed_1pctl is idempotent and runs on upgrade as well as install, so an install
# that predates this packaging is repaired by updating the app.
seed_1pctl() {
    # 安装向导值（wizard_entrance/wizard_username/wizard_password 由 fnOS 在安装时注入）优先；
    # 为空（升级/无向导路径）则回退随机值。已有 CREDENTIALS.txt 时不覆盖。
    local creds="${TRIM_PKGVAR}/CREDENTIALS.txt"
    local username password entrance
    if [ -f "$creds" ]; then
        username=$(grep '^username=' "$creds" | cut -d= -f2-)
        password=$(grep '^password=' "$creds" | cut -d= -f2-)
        entrance=$(grep '^entrance=' "$creds" | cut -d= -f2-)
    else
        username="${wizard_username:-admin}"
        password="${wizard_password:-$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 16)}"
        entrance="${wizard_entrance:-$(openssl rand -hex 4 2>/dev/null || head -c 4 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 8)}"
        mkdir -p "${TRIM_PKGVAR}"
        umask 077
        cat > "$creds" <<CREDS
# 1Panel 安装时设置的登录凭证。登录后请在面板设置中修改并删除本文件。
username=$username
password=$password
entrance=$entrance
url=http://<NAS-IP>:18090/$entrance
CREDS
    fi

    # 面板版本号：1panel-core 启动时 grep 这个键（core/init/viper/viper.go），它决定右下角
    # 角标显示什么，以及能否和官方最新版比对（core/app/service/upgrade.go）。必须是上游版本
    # （如 v2.3.2）：
    #  - fnOS 注入的变量叫 TRIM_APPVER，**没有** TRIM_APPVERSION；原先的
    #    ${TRIM_APPVERSION:-unknown} 永远写成 "unknown" → 角标显示“社区版 unknown”，
    #    且与官方版本比较永远不相等 → 一直提示可升级；
    #  - 本源版本号带 "-N" 打包序号（2.3.2-1），必须去掉，否则 2.3.2-1 在版本比较里
    #    仍小于 2.3.2，照样提示升级。
    # build-1panel.sh 打包时会用本次实际下载的上游版本覆盖下面这行，作为权威值。
    local panel_version="unknown"
    if [ -n "${TRIM_APPVER:-}" ]; then
        panel_version="v${TRIM_APPVER%%-*}"
    fi

    if ! mkdir -p /usr/local/bin 2>/dev/null || ! : > /usr/local/bin/1pctl 2>/dev/null; then
        echo "ERROR: cannot write /usr/local/bin/1pctl (running as $(id -un), needs root)." >&2
        echo "       1panel will panic on start with: error \`BASE_DIR\` find in /usr/local/bin/1pctl" >&2
        echo "       Check install_type=root in the manifest and run-as root in config/privilege." >&2
        return 1
    fi
    cat > /usr/local/bin/1pctl <<EOF
#!/bin/bash
# Stub config-source for 1panel. The daemon greps these KEY=VALUE lines at first
# boot, then migrates values into its SQLite DB at ${TRIM_PKGVAR}/1panel/db/1Panel.db.
# Managed by fnos-apps; change settings via the 1panel UI — do not edit here.
BASE_DIR=${TRIM_PKGVAR}
ORIGINAL_PORT=18090
ORIGINAL_VERSION=${panel_version}
ORIGINAL_ENTRANCE=$entrance
ORIGINAL_USERNAME=$username
ORIGINAL_PASSWORD=$password
LANGUAGE=zh
PANEL_EDITION=cn
CHANGE_USER_INFO=false
EOF
    chmod 755 /usr/local/bin/1pctl 2>/dev/null || true

    # v2 core 期望地理库位于 $BASE_DIR/1panel/geo/，语言资源位于 /usr/local/bin/lang/
    # （/usr/local/bin/1pctl 会 source /usr/local/bin/lang/$LANGUAGE.sh）。
    # 这些资源随包分发在 ${APP_DIR} 下，这里做首次部署。
    if [ -f "${APP_DIR}/GeoIP.mmdb" ]; then
        mkdir -p "${TRIM_PKGVAR}/1panel/geo"
        cp -f "${APP_DIR}/GeoIP.mmdb" "${TRIM_PKGVAR}/1panel/geo/GeoIP.mmdb" 2>/dev/null || true
    fi
    if [ -d "${APP_DIR}/lang" ]; then
        mkdir -p /usr/local/bin/lang
        cp -f "${APP_DIR}"/lang/*.sh /usr/local/bin/lang/ 2>/dev/null || true
        chmod 755 /usr/local/bin/lang/*.sh 2>/dev/null || true
    fi
}

service_preinst() {
    seed_1pctl
}

# Repairs installs that predate the root packaging, and refreshes the port and
# version keys after every update.
service_postupgrade() {
    seed_1pctl
}

service_preuninst() {
    # Clean up the 1pctl stub we created (runs as root).
    rm -f /usr/local/bin/1pctl

    # v2 双进程：core + agent 都要停。用 -x 精确匹配进程名，
    # 避免误杀 appcenter-cli 等包含 "1panel" 参数的进程
    pkill -x "1panel-core" 2>/dev/null || true
    pkill -x "1panel-agent" 2>/dev/null || true
    sleep 1
    pkill -9 -x "1panel-core" 2>/dev/null || true
    pkill -9 -x "1panel-agent" 2>/dev/null || true
}

service_poststop() {
    pkill -x "1panel-core" 2>/dev/null || true
    pkill -x "1panel-agent" 2>/dev/null || true
    sleep 1
    pkill -9 -x "1panel-core" 2>/dev/null || true
    pkill -9 -x "1panel-agent" 2>/dev/null || true
}
